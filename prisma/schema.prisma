// Nisbat data model.
//
// Workflow/status fields are relational (queryable, indexable); deeply
// nested or evolving clinical content (DischargeContent, audit trail, applied
// advice sections, etc.) is stored as jsonb, mirroring the TypeScript domain
// model in src/types/ 1:1 so the API layer stays a thin pass-through rather
// than a second schema to keep in sync. Dates are stored as ISO strings, not
// native Date/timestamp columns, for the same reason — no conversion layer
// between the client's ISO-string domain model and the database.
//
// Deliberately plain Postgres (no Supabase-specific extensions/RLS) so this
// ports to any managed Postgres — Supabase included — by swapping
// DATABASE_URL, no schema changes.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AppUser {
  id           String  @id
  name         String
  role         String // pgr_mo | sr_faculty | admin
  designation  String
  username     String  @unique
  passwordHash String
  active       Boolean @default(true)
}

model InstitutionalSettings {
  id                    String @id @default("singleton")
  hospitalName          String
  logoUrl               String?
  department            String
  hodName               String
  contactPhone          String
  contactAddress        String
  defaultPaperSize      String
  defaultParentLanguage String
}

model Patient {
  id                 String      @id
  mrNumber           String
  name               String
  fatherGuardianName String
  dob                String
  sex                String
  contactPhone       String?
  address            String?
  admissions         Admission[]
}

model Admission {
  id                  String      @id
  patientId           String
  patient             Patient     @relation(fields: [patientId], references: [id])
  admissionDate       String
  dischargeDate       String?
  wardBed             String
  reasonForAdmission  String
  weightKg            Float
  heightCm            Float?
  lengthCm            Float?
  headCircumferenceCm Float?
  allergy             Json
  alerts              Json
  status              String
  discharges          Discharge[]

  @@index([patientId])
}

model Discharge {
  id                    String    @id
  admissionId           String
  admission             Admission @relation(fields: [admissionId], references: [id])
  patientId             String
  status                String
  revisionNumber        Int
  templateId            String
  templateAutoSelected  Boolean
  parentLanguage        String
  medicationsLanguage   String?
  followUpLanguage      String?
  paperSize             String
  content               Json
  preparedById          String
  preparedByName        String
  reviewerId            String?
  reviewerName          String?
  completedById         String?
  completedByName       String?
  revisionHistory       Json
  institutionalSnapshot Json?
  printEvents           Json
  auditTrail            Json
  archived              Boolean
  archivedReason        String?
  createdAt             String
  updatedAt             String

  @@index([admissionId])
  @@index([patientId])
}

model Drug {
  id           String        @id
  name         String
  genericClass String?
  formulary    String
  formulations Formulation[]
  doseRules    DoseRule[]
}

model Formulation {
  id            String @id
  drugId        String
  drug          Drug   @relation(fields: [drugId], references: [id])
  form          String
  strengthLabel String
  mgPerMl       Float?
  mgPerUnit     Float?
  brandNames    Json?

  @@index([drugId])
}

model DoseRule {
  id                   String  @id
  drugId               String
  drug                 Drug    @relation(fields: [drugId], references: [id])
  label                String
  basis                String
  mgPerKg              Float?
  mgPerKgMax           Float?
  fixedMg              Float?
  instructionText      String?
  defaultFrequencyCode String
  maxMgPerDose         Float?
  maxMgPerDay          Float?
  maxMgPerKgPerDay     Float?
  minAgeMonths         Float?
  maxAgeMonths         Float?
  source               String // system | faculty — system rows are never editable via the API
  status               String // draft | published
  version              Int
  createdBy            String
  publishedBy          String?
  updatedAt            String

  @@index([drugId])
}

model AdvicePack {
  id              String  @id
  title           String
  category        String
  version         Int
  status          String
  linkedDiagnoses Json
  sections        Json
  createdBy       String
  publishedBy     String?
  updatedAt       String
}

model FollowUpModule {
  id                     String  @id
  service                String
  version                Int
  status                 String
  defaultTimingLabel     String
  purpose                String
  purposeUr              String?
  instructions           String
  instructionsUr         String?
  hasPendingResultReview Boolean
  linkedDiagnoses        Json
  createdBy              String
  publishedBy            String?
  updatedAt              String
}

model InvestigationPanel {
  id          String  @id
  name        String
  category    String?
  version     Int
  status      String
  tests       Json
  createdBy   String
  publishedBy String?
  updatedAt   String
}

model FrequencyPhrase {
  id            String  @id
  frequencyCode String
  phraseEnglish String
  phraseUrdu    String
  version       Int
  status        String
  createdBy     String
  publishedBy   String?
  updatedAt     String

  @@index([frequencyCode])
}

model VocabularyList {
  id             String  @id
  key            String  @unique
  label          String
  chipsBySystem  Json?
  flatItems      Json?
  version        Int
  status         String
  createdBy      String
  publishedBy    String?
  updatedAt      String
}

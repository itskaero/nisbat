# Local Postgres (docker compose up -d). Port 5433 — 5432 was already taken by
# another project's Postgres on this machine. Swap this for a cloud Postgres
# connection string (Supabase, Neon, RDS, etc.) later with zero schema changes.
DATABASE_URL="postgresql://nisbat:nisbat_dev_password@localhost:5433/nisbat"

# Signs the login session cookie (HMAC-SHA256) — required, the app won't
# start without it. Generate your own, don't reuse this or any example value:
#   openssl rand -base64 32
SESSION_SECRET="replace-with-your-own-openssl-rand--base64-32-output"
